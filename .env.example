# ─────────────────────────────────────────────────────────────────────────────
# Wildlife Sentinel — Environment Configuration
# OpenCV AI Competition 2026 Submission
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_any_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ── Alerts (optional — leave blank to disable) ───────────────────────────────
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_RECEIVER=alerts_go_here@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

TELEGRAM_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# ── Storage ───────────────────────────────────────────────────────────────────
VIDEO_DIR=videos
UPLOAD_DIR=uploads
CLIP_DURATION=60

# ── Detection Tuning ─────────────────────────────────────────────────────────
CONF_THRESHOLD=0.40
IOU_THRESHOLD=0.35
TRACK_BUFFER=90
FRAME_SKIP=3
MAX_ABSENT_FRAMES=90

# ── Model Selection ──────────────────────────────────────────────────────────
# Options: yolov8n-seg.pt (nano), yolov8s-seg.pt (small), yolov8m-seg.pt (medium)
SEG_MODEL=yolov8s-seg.pt

# ── Performance ───────────────────────────────────────────────────────────────
# GPU batch size for video analysis (increase on high-VRAM GPUs)
BATCH_SIZE=8
FLASK_DEBUG=0

# ── OpenCV 5 Enhanced Pipeline (optional — set to enable) ────────────────────
# Enable advanced OpenCV 5 preprocessing on frames
OPENCV5_PIPELINE=true
# Enable frame denoising for low-light conditions
OPENCV5_DENOISE=false
# Enable contrast enhancement (CLAHE)
OPENCV5_CLAHE=true
# Enable background subtraction pre-filter
OPENCV5_BG_SUBTRACT=true
# Enable video stabilization (for shaky trail cameras)
OPENCV5_STABILIZE=false

# ─────────────────────────────────────────────────────────────────────────────
# AWS Integration (optional — set USE_AWS=true to enable)
# ─────────────────────────────────────────────────────────────────────────────
USE_AWS=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=wildlife-sentinel-data
AWS_DYNAMODB_TABLE=wildlife-sentinel-events
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:wildlife-alerts

# AWS credentials — prefer IAM roles or AWS CLI profiles over hardcoding
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Enable specific AWS features individually
AWS_UPLOAD_CLIPS=true
AWS_UPLOAD_SNAPSHOTS=true
AWS_REKOGNITION_VERIFY=false
AWS_DYNAMODB_LOG=true
AWS_SNS_ALERTS=false
